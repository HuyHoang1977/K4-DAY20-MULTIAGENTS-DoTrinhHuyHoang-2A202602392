# Copy this file to .env and fill in the values. NEVER commit .env.

# --- Google Gemini (https://aistudio.google.com/apikey) ---
# Provider prefix must be google_genai (Gemini API / AI Studio, free tier).
# "gemini:..." resolves to Vertex AI and requires a GCP project.
LAB_MODEL=google_genai:gemini-3.8-flash
GOOGLE_API_KEY=

LAB_TEMPERATURE=0

# --- Option 1 - Azure OpenAI or an OpenAI-compatible gateway (give all three).
# Takes priority over the Gemini settings above if all three are filled:
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT_MODEL=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview   # only for real *.openai.azure.com endpoints

# --- Option 2 - DeepSeek ---
# LAB_MODEL=deepseek:deepseek-chat
# DEEPSEEK_API_KEY=